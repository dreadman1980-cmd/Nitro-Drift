name: Build Release AAB

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.5

      - name: Build Release AAB
        # IF YOUR SETTINGS.GRADLE IS INSIDE A SUBFOLDER (e.g., Nitro-Drift or android)
        # UNCOMMENT THE NEXT LINE AND PUT THE SUBFOLDER NAME:
        # working-directory: ./Nitro-Drift
        run: gradle app:bundleRelease --stacktrace

      - name: Upload AAB
        uses: actions/upload-artifact@v4
        with:
          name: app-release-aab
          path: "**/build/outputs/bundle/release/*.aab"
